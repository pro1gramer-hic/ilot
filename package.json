{
  "name": "ilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --exclude \".claude/**\"",
    "test:ui": "playwright test",
    "verify": "npm run prepare-relay && npm run check && npm run lint && npm run test && cargo clippy -- -D warnings && cargo test && cargo audit && npm audit",
    "prepare-relay": "node scripts/prepare-relay.mjs debug",
    "i18n:translate": "node scripts/translate-catalog.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@tauri-apps/api": "2.12.1"
  }
}

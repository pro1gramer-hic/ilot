{
  "manifest_version": 3,
  "name": "îlot · vidéo flottante",
  "description": "Laisse îlot détacher l'épisode Crunchyroll dans le lecteur flottant du navigateur. Ne lit, ne copie ni n'envoie aucune image.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "alarms"],
  "host_permissions": ["https://*.crunchyroll.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.crunchyroll.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Détacher la vidéo Crunchyroll" },
  "commands": {
    "detacher": {
      "suggested_key": { "default": "Ctrl+Shift+8" },
      "description": "Détacher la vidéo Crunchyroll",
      "global": true
    }
  }
}
